{
  "manifest_version": 3,
  "name": "Local Strategy Research Studio Bridge",
  "version": "0.4.0",
  "minimum_chrome_version": "116",
  "description": "Connect your own TradingView session to a local strategy research app. Backtest reports stay on your computer.",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "notifications",
    "alarms",
    "downloads"
  ],
  "host_permissions": [
    "*://*.tradingview.com/*"
  ],
  "options_ui": {
    "page": "mcp-options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "研究室本機連線",
    "default_popup": "mcp-options.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.tradingview.com/*"
      ],
      "js": [
        "research-content.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page-context.js"
      ],
      "matches": [
        "*://*.tradingview.com/*"
      ]
    }
  ]
}
